{"version":3,"term":{"cols":80,"rows":24},"timestamp":1776831183,"command":"bash /tmp/demo-script.sh","env":{"SHELL":"/bin/zsh"}}
[0.006, "o", "$ meowsql analyze \\\r\n"]
[0.306, "o", "    --dsn \"mysql://meowsql:meowsql@localhost:3306/shop\" \\\r\n"]
[0.306, "o", "    --file slow_orders.sql\r\n"]
[0.805, "o", "\r\n\u001b[1;96m🐾 MeowSQL\u001b[0m  \u001b[90mMySQL 8.0.45\u001b[0m\r\n\r\n"]
[0.205, "o", "\u001b[1;93mDiagnosis\u001b[0m\r\n  The query applies LOWER() to the email column in WHERE, which is\r\n"]
[0.000, "o", "  non-SARGable and forces a full table scan of ~497k rows. The date\r\n"]
[0.000, "o", "  filter on created_at is applied after the scan, and ORDER BY\r\n  created_at DESC requires a filesort across the matching result set.\r\n\r\n"]
[0.204, "o", "  \u001b[31m•\u001b[0m Non-SARGable predicate: LOWER(o.email) prevents index usage on email\r\n  \u001b[31m•\u001b[0m No composite index to cover the email predicate + date range filter\r\n"]
[0.000, "o", "  \u001b[31m•\u001b[0m Missing index on created_at forces an expensive filesort\r\n"]
[0.000, "o", "\r\n"]
[0.307, "o", "\u001b[1;93mSuggested indexes\u001b[0m\r\n  \u001b[32mCREATE INDEX idx_orders_lower_email ON orders ((LOWER(email)), created_at DESC)\u001b[0m\r\n    \u001b[90mFunctional composite index on LOWER(email) + created_at DESC enables\u001b[0m\r\n"]
[0.000, "o", "    \u001b[90mindex seek on the lowercased value and satisfies ORDER BY — no filesort.\u001b[0m\r\n\r\n"]
[0.308, "o", "\u001b[1;93mEstimated impact\u001b[0m\r\n"]
[0.000, "o", "  100x–1000x faster: eliminates full scan (497k rows) and filesort.\r\n"]
[0.000, "o", "\r\n"]
[0.207, "o", "\u001b[1;93mCaveats\u001b[0m\r\n"]
[0.000, "o", "  \u001b[90m•\u001b[0m Functional indexes require InnoDB (MySQL 8+). Verify storage engine.\r\n"]
[0.000, "o", "  \u001b[90m•\u001b[0m Index adds write overhead on INSERT/UPDATE; monitor DML performance.\r\n"]
[0.000, "o", "  \u001b[90m•\u001b[0m Confirm case-insensitive email matching is semantically correct.\r\n"]
[0.307, "o", "\r\n$ "]
[2.006, "x", "0"]
